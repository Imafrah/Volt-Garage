PART 4: KEY CONFIGURATION FILES
A. Firestore Security Rules

JavaScript
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    
    // Drivers can read/write their own record
    match /drivers/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    
    // Hosts can read/write their own record
    match /hosts/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    
    // Anyone can read charging points
    match /chargingPoints/{pointId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == resource.data.hostUid;
    }
    
    // Drivers can create reservations, read their own
    match /reservations/{resId} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.hostId;
      allow update: if request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.hostId;
    }
    
    // Charging sessions (read-only for drivers/hosts)
    match /chargingSessions/{sessionId} {
      allow read: if request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.hostId;
    }
    
    // Payments (read-only for drivers/hosts)
    match /payments/{paymentId} {
      allow read: if request.auth.uid == resource.data.driverId || request.auth.uid == resource.data.hostId;
    }
  }
}
